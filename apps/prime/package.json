{
  "name": "@gremlin/prime",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsx watch src/main.ts",
    "migrate": "tsx src/migrate.ts",
    "principal:create": "tsx src/create-principal.ts",
    "principal:grant-memory-read": "tsx src/grant-memory-read.ts",
    "principal:rotate-key": "tsx src/rotate-principal-key.ts",
    "source:export": "tsx src/export-source.ts",
    "start": "node dist/main.js",
    "test": "vitest run --exclude '**/*.integration.test.ts'",
    "test:integration": "vitest run test/integration --no-file-parallelism",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@fastify/rate-limit": "^10.3.0",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "fastify": "^5.12.1",
    "postgres": "^3.4.9",
    "zod": "^4.5.4"
  }
}

# Local-development values only. Use a generated secret outside development.
POSTGRES_PASSWORD=gremlin-dev
HTTP_PORT=3000
CHAT_HTTP_PORT=3001
LOG_LEVEL=info

# Create this principal after Prime and the migrations are running. The key is
# displayed once by: pnpm principal:create client:gremlin-chat
GREMLIN_CHAT_API_KEY=

# Create a dedicated OpenRouter key with an appropriate credit limit.
OPENROUTER_API_KEY=
DEFAULT_CHAT_MODEL=

# The embedding model must remain stable so retrieval uses the same vector
# space. Background consolidation is opt-in until production acceptance.
CONSOLIDATION_MODEL=
EMBEDDING_MODEL=
CONSOLIDATION_BATCH_SIZE=20
CONSOLIDATION_MAX_SOURCE_CHARACTERS=200000
BACKGROUND_CONSOLIDATION_ENABLED=false
CONSOLIDATION_POLL_INTERVAL_MS=60000
CONSOLIDATION_RETRY_DELAY_MS=300000
CONSOLIDATION_MAX_ATTEMPTS=3
CONSOLIDATION_PRINCIPAL_ID=system:consolidator
MODEL_REQUEST_TIMEOUT_MS=60000

# Gremlin Chat retrieves this many authorized memories and injects only those
# that fit its approximate context-token budget.
MEMORY_SEARCH_LIMIT=5
MEMORY_CONTEXT_MAX_TOKENS=1200
